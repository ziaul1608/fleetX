# ==============================================================================
# FleetX — Environment Configuration Template
# Academic Year: 2026-27 | System: Intelligent Fleet & Logistics Management
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# Never commit real passwords, tokens, or private secrets to version control.
# ==============================================================================

# Database Configuration (MySQL 8.4 LTS)
MYSQL_DATABASE=fleetx
MYSQL_USER=fleetx_user
MYSQL_PASSWORD=fleetx_dev_password_change_me
MYSQL_ROOT_PASSWORD=fleetx_root_password_change_me
MYSQL_PORT=3306

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fleetx?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=fleetx_user
SPRING_DATASOURCE_PASSWORD=fleetx_dev_password_change_me

# Bootstrap Administrator & Development Demo Seeding
BOOTSTRAP_ADMIN_EMAIL=admin@fleetx.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_in_env
BOOTSTRAP_ADMIN_NAME=System Administrator
DEMO_SEED_ENABLED=true

# Frontend Application Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws/fleetx
